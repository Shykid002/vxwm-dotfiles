#!/bin/sh

# autolock
xautolock -time 10 -locker "$HOME/scripts/lock.sh" -detectsleep &

# Polkit
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &

# Wallpaper
"$HOME/scripts/restore-wallpaper.sh" &

export QT_QPA_PLATFORMTHEME=qt6ct
export QT_STYLE_OVERRIDE=kvantum

#xwallpaper --stretch "$HOME/Pictures/Wallpapers/solarized-wall-47.jpg"

# Pywal
#wal -i "$HOME/Pictures/Wallpapers/solarized-wall-47.jpg"
#xrdb -merge "$HOME/.cache/wal/colors.Xresources"

# MDP
pgrep -x mpd >/dev/null || mpd &

# Compositor
picom &

# Notifications
dunst &

# easyeffects
easyeffects --gapplication-service &


# Start the gesture tracking daemon
libinput-gestures-setup start &


# Status bar updater
"$HOME/scripts/vxwm_bar.sh" &
