# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0b0404"

# Main text color
theme[main_fg]="#c2c0c0"

# Title color for boxes
theme[title]="#c2c0c0"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#474747"

# Background color of selected item in processes box
theme[selected_bg]="#8F8F8F"

# Foreground color of selected item in processes box
theme[selected_fg]="#c2c0c0"

# Color of inactive/disabled text
theme[inactive_fg]="#919090"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c2c0c0"

# Background color of the percentage meters
theme[meter_bg]="#181616"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#575757"

# Cpu box outline color
theme[cpu_box]="#6F6F6F"

# Memory/disks box outline color
theme[mem_box]="#AEAEAE"

# Net up/down box outline color
theme[net_box]="#575757"

# Processes box outline color
theme[proc_box]="#CECECE"

# Box divider line and small boxes line color
theme[div_line]="#3b3636"

# Temperature graph colors
theme[temp_start]="#6F6F6F"
theme[temp_mid]="#AEAEAE"
theme[temp_end]="#CECECE"

# CPU graph colors
theme[cpu_start]="#6F6F6F"
theme[cpu_mid]="#AEAEAE"
theme[cpu_end]="#CECECE"

# Mem/Disk free meter
theme[free_start]="#6F6F6F"
theme[free_mid]="#AEAEAE"
theme[free_end]="#CECECE"

# Mem/Disk cached meter
theme[cached_start]="#6F6F6F"
theme[cached_mid]="#AEAEAE"
theme[cached_end]="#CECECE"

# Mem/Disk available meter
theme[available_start]="#6F6F6F"
theme[available_mid]="#AEAEAE"
theme[available_end]="#CECECE"

# Mem/Disk used meter
theme[used_start]="#6F6F6F"
theme[used_mid]="#AEAEAE"
theme[used_end]="#CECECE"

# Download graph colors
theme[download_start]="#6F6F6F"
theme[download_mid]="#AEAEAE"
theme[download_end]="#CECECE"

# Upload graph colors
theme[upload_start]="#6F6F6F"
theme[upload_mid]="#AEAEAE"
theme[upload_end]="#CECECE"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#6F6F6F"
theme[process_mid]="#AEAEAE"
theme[process_end]="#CECECE"
