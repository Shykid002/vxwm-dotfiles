# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#1e160d"

# Main text color
theme[main_fg]="#c6c4c2"

# Title color for boxes
theme[title]="#c6c4c2"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#304555"

# Background color of selected item in processes box
theme[selected_bg]="#976959"

# Foreground color of selected item in processes box
theme[selected_fg]="#c6c4c2"

# Color of inactive/disabled text
theme[inactive_fg]="#949391"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c6c4c2"

# Background color of the percentage meters
theme[meter_bg]="#43311d"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#30516C"

# Cpu box outline color
theme[cpu_box]="#56565B"

# Memory/disks box outline color
theme[mem_box]="#B78D73"

# Net up/down box outline color
theme[net_box]="#30516C"

# Processes box outline color
theme[proc_box]="#47718B"

# Box divider line and small boxes line color
theme[div_line]="#4b443d"

# Temperature graph colors
theme[temp_start]="#56565B"
theme[temp_mid]="#B78D73"
theme[temp_end]="#47718B"

# CPU graph colors
theme[cpu_start]="#56565B"
theme[cpu_mid]="#B78D73"
theme[cpu_end]="#47718B"

# Mem/Disk free meter
theme[free_start]="#56565B"
theme[free_mid]="#B78D73"
theme[free_end]="#47718B"

# Mem/Disk cached meter
theme[cached_start]="#56565B"
theme[cached_mid]="#B78D73"
theme[cached_end]="#47718B"

# Mem/Disk available meter
theme[available_start]="#56565B"
theme[available_mid]="#B78D73"
theme[available_end]="#47718B"

# Mem/Disk used meter
theme[used_start]="#56565B"
theme[used_mid]="#B78D73"
theme[used_end]="#47718B"

# Download graph colors
theme[download_start]="#56565B"
theme[download_mid]="#B78D73"
theme[download_end]="#47718B"

# Upload graph colors
theme[upload_start]="#56565B"
theme[upload_mid]="#B78D73"
theme[upload_end]="#47718B"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#56565B"
theme[process_mid]="#B78D73"
theme[process_end]="#47718B"
