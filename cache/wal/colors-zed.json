{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#12151b90",
                "editor.background": "#12151b90",
                "editor.foreground": "#c3c4c6",
                "text": "#c3c4c6",
                "text.muted": "#c3c4c670",
                "text.ignored": "#c3c4c640",
                "text.placeholder": "#c3c4c650",
                "ignored": "#c3c4c630",
                "element.hover": "#c3c4c630",
                "ghost_element.hover": "#545B4E30",
                "ghost_element.selected": "#545B4E30",
                "ghost_element.active": "#545B4E60",
                "border": "#12151b",
                "editor.highlighted_line.background": "#545B4E10",
                "editor.active_line.background": "#545B4E10",
                "panel.background": "#12151b90",
                "title_bar.background": "#12151b90",
                "title_bar.inactive_background": "#12151b90",
                "status_bar.background": "#12151b90",
                "drop_target.background": "#12151b90",
                "elevated_surface.background": "#12151b",
                "toolbar.background": "#12151b90",
                "tab_bar.background": "#12151b90",
                "tab.inactive_background": "#12151b90",
                "tab.active_background": "#545B4E30",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#12151b",
                "scrollbar.thumb.background": "#545B4E",
                "editor.gutter.background": "#12151b90",
                "terminal.background": "#12151b10",
                "terminal.foreground": "#c3c4c6",
                "terminal.dim_foreground": "#c3c4c6",
                "terminal.bright_foreground": "#c3c4c6",
                "terminal.ansi.black": "#12151b",
                "terminal.ansi.red": "#545B4E",
                "terminal.ansi.green": "#A98B5D",
                "terminal.ansi.yellow": "#C79F60",
                "terminal.ansi.blue": "#DAB068",
                "terminal.ansi.magenta": "#E3BB6D",
                "terminal.ansi.cyan": "#DFC07E",
                "terminal.ansi.white": "#c3c4c6",
                "terminal.ansi.bright_black": "#5c6371",
                "terminal.ansi.bright_red": "#545B4E",
                "terminal.ansi.bright_green": "#A98B5D",
                "terminal.ansi.bright_yellow": "#C79F60",
                "terminal.ansi.bright_blue": "#DAB068",
                "terminal.ansi.bright_magenta": "#E3BB6D",
                "terminal.ansi.bright_cyan": "#DFC07E",
                "terminal.ansi.bright_white": "#c3c4c6",
                "modified": "#545B4E",
                "syntax": {
                    "attribute": {
                        "color": "#545B4E"
                    },
                    "boolean": {
                      "color": "#A98B5D"
                    },
                    "comment": {
                      "color": "#5c6371"
                    },
                    "comment.doc": {
                      "color": "#5c6371"
                    },
                    "constant": {
                      "color": "#A98B5D"
                    },
                    "function": {
                      "color": "#DFC07E"
                    },
                    "keyword": {
                      "color": "#DAB068"
                    },
                    "number": {
                      "color": "#E3BB6D"
                    },
                    "operator": {
                      "color": "#DAB068"
                    },
                    "string": {
                      "color": "#545B4E"
                    },
                    "variable": {
                      "color": "#A98B5D"
                    }
                },
                "players": [
                  {
                    "cursor": "#545B4E",
                    "background": "#12151b",
                    "selection": "#545B4E30"
                  }
                ]
            }
        }
    ]
}
