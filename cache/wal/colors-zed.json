{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#1e160d90",
                "editor.background": "#1e160d90",
                "editor.foreground": "#c6c4c2",
                "text": "#c6c4c2",
                "text.muted": "#c6c4c270",
                "text.ignored": "#c6c4c240",
                "text.placeholder": "#c6c4c250",
                "ignored": "#c6c4c230",
                "element.hover": "#c6c4c230",
                "ghost_element.hover": "#30455530",
                "ghost_element.selected": "#30455530",
                "ghost_element.active": "#30455560",
                "border": "#1e160d",
                "editor.highlighted_line.background": "#30455510",
                "editor.active_line.background": "#30455510",
                "panel.background": "#1e160d90",
                "title_bar.background": "#1e160d90",
                "title_bar.inactive_background": "#1e160d90",
                "status_bar.background": "#1e160d90",
                "drop_target.background": "#1e160d90",
                "elevated_surface.background": "#1e160d",
                "toolbar.background": "#1e160d90",
                "tab_bar.background": "#1e160d90",
                "tab.inactive_background": "#1e160d90",
                "tab.active_background": "#30455530",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#1e160d",
                "scrollbar.thumb.background": "#304555",
                "editor.gutter.background": "#1e160d90",
                "terminal.background": "#1e160d10",
                "terminal.foreground": "#c6c4c2",
                "terminal.dim_foreground": "#c6c4c2",
                "terminal.bright_foreground": "#c6c4c2",
                "terminal.ansi.black": "#1e160d",
                "terminal.ansi.red": "#304555",
                "terminal.ansi.green": "#30516C",
                "terminal.ansi.yellow": "#56565B",
                "terminal.ansi.blue": "#976959",
                "terminal.ansi.magenta": "#B78D73",
                "terminal.ansi.cyan": "#47718B",
                "terminal.ansi.white": "#c6c4c2",
                "terminal.ansi.bright_black": "#70675c",
                "terminal.ansi.bright_red": "#304555",
                "terminal.ansi.bright_green": "#30516C",
                "terminal.ansi.bright_yellow": "#56565B",
                "terminal.ansi.bright_blue": "#976959",
                "terminal.ansi.bright_magenta": "#B78D73",
                "terminal.ansi.bright_cyan": "#47718B",
                "terminal.ansi.bright_white": "#c6c4c2",
                "modified": "#304555",
                "syntax": {
                    "attribute": {
                        "color": "#304555"
                    },
                    "boolean": {
                      "color": "#30516C"
                    },
                    "comment": {
                      "color": "#70675c"
                    },
                    "comment.doc": {
                      "color": "#70675c"
                    },
                    "constant": {
                      "color": "#30516C"
                    },
                    "function": {
                      "color": "#47718B"
                    },
                    "keyword": {
                      "color": "#976959"
                    },
                    "number": {
                      "color": "#B78D73"
                    },
                    "operator": {
                      "color": "#976959"
                    },
                    "string": {
                      "color": "#304555"
                    },
                    "variable": {
                      "color": "#30516C"
                    }
                },
                "players": [
                  {
                    "cursor": "#304555",
                    "background": "#1e160d",
                    "selection": "#30455530"
                  }
                ]
            }
        }
    ]
}
