! X colors.
! Generated by 'wal'
*foreground:        #c2c0c0
*background:        #0b0404
*.foreground:       #c2c0c0
*.background:       #0b0404
emacs*foreground:   #c2c0c0
emacs*background:   #0b0404
URxvt*foreground:   #c2c0c0
XTerm*foreground:   #c2c0c0
UXTerm*foreground:  #c2c0c0
URxvt*background:   [100]#0b0404
XTerm*background:   #0b0404
UXTerm*background:  #0b0404
URxvt*cursorColor:  #c2c0c0
XTerm*cursorColor:  #c2c0c0
UXTerm*cursorColor: #c2c0c0
URxvt*borderColor:  [100]#0b0404

! Colors 0-15.
*.color0: #0b0404
*color0:  #0b0404
*.color1: #474747
*color1:  #474747
*.color2: #575757
*color2:  #575757
*.color3: #6F6F6F
*color3:  #6F6F6F
*.color4: #8F8F8F
*color4:  #8F8F8F
*.color5: #AEAEAE
*color5:  #AEAEAE
*.color6: #CECECE
*color6:  #CECECE
*.color7: #c2c0c0
*color7:  #c2c0c0
*.color8: #665454
*color8:  #665454
*.color9: #474747
*color9:  #474747
*.color10: #575757
*color10:  #575757
*.color11: #6F6F6F
*color11:  #6F6F6F
*.color12: #8F8F8F
*color12:  #8F8F8F
*.color13: #AEAEAE
*color13:  #AEAEAE
*.color14: #CECECE
*color14:  #CECECE
*.color15: #c2c0c0
*color15:  #c2c0c0

! Black color that will not be affected by bold highlighting.
*.color66: #0b0404
*color66:  #0b0404

! Xclock colors.
XClock*foreground: #c2c0c0
XClock*background: #0b0404
XClock*majorColor:  rgba:c2/c0/c0/ff
XClock*minorColor:  rgba:c2/c0/c0/ff
XClock*hourColor:   rgba:c2/c0/c0/ff
XClock*minuteColor: rgba:c2/c0/c0/ff
XClock*secondColor: rgba:c2/c0/c0/ff

! Set depth to make transparency work.
URxvt*depth: 32
