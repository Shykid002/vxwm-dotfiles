! X colors.
! Generated by 'wal'
*foreground:        #c3c4c6
*background:        #12151b
*.foreground:       #c3c4c6
*.background:       #12151b
emacs*foreground:   #c3c4c6
emacs*background:   #12151b
URxvt*foreground:   #c3c4c6
XTerm*foreground:   #c3c4c6
UXTerm*foreground:  #c3c4c6
URxvt*background:   [100]#12151b
XTerm*background:   #12151b
UXTerm*background:  #12151b
URxvt*cursorColor:  #c3c4c6
XTerm*cursorColor:  #c3c4c6
UXTerm*cursorColor: #c3c4c6
URxvt*borderColor:  [100]#12151b

! Colors 0-15.
*.color0: #12151b
*color0:  #12151b
*.color1: #545B4E
*color1:  #545B4E
*.color2: #A98B5D
*color2:  #A98B5D
*.color3: #C79F60
*color3:  #C79F60
*.color4: #DAB068
*color4:  #DAB068
*.color5: #E3BB6D
*color5:  #E3BB6D
*.color6: #DFC07E
*color6:  #DFC07E
*.color7: #c3c4c6
*color7:  #c3c4c6
*.color8: #5c6371
*color8:  #5c6371
*.color9: #545B4E
*color9:  #545B4E
*.color10: #A98B5D
*color10:  #A98B5D
*.color11: #C79F60
*color11:  #C79F60
*.color12: #DAB068
*color12:  #DAB068
*.color13: #E3BB6D
*color13:  #E3BB6D
*.color14: #DFC07E
*color14:  #DFC07E
*.color15: #c3c4c6
*color15:  #c3c4c6

! Black color that will not be affected by bold highlighting.
*.color66: #12151b
*color66:  #12151b

! Xclock colors.
XClock*foreground: #c3c4c6
XClock*background: #12151b
XClock*majorColor:  rgba:c3/c4/c6/ff
XClock*minorColor:  rgba:c3/c4/c6/ff
XClock*hourColor:   rgba:c3/c4/c6/ff
XClock*minuteColor: rgba:c3/c4/c6/ff
XClock*secondColor: rgba:c3/c4/c6/ff

! Set depth to make transparency work.
URxvt*depth: 32
