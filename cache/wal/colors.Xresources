! X colors.
! Generated by 'wal'
*foreground:        #c6c4c2
*background:        #1e160d
*.foreground:       #c6c4c2
*.background:       #1e160d
emacs*foreground:   #c6c4c2
emacs*background:   #1e160d
URxvt*foreground:   #c6c4c2
XTerm*foreground:   #c6c4c2
UXTerm*foreground:  #c6c4c2
URxvt*background:   [100]#1e160d
XTerm*background:   #1e160d
UXTerm*background:  #1e160d
URxvt*cursorColor:  #c6c4c2
XTerm*cursorColor:  #c6c4c2
UXTerm*cursorColor: #c6c4c2
URxvt*borderColor:  [100]#1e160d

! Colors 0-15.
*.color0: #1e160d
*color0:  #1e160d
*.color1: #304555
*color1:  #304555
*.color2: #30516C
*color2:  #30516C
*.color3: #56565B
*color3:  #56565B
*.color4: #976959
*color4:  #976959
*.color5: #B78D73
*color5:  #B78D73
*.color6: #47718B
*color6:  #47718B
*.color7: #c6c4c2
*color7:  #c6c4c2
*.color8: #70675c
*color8:  #70675c
*.color9: #304555
*color9:  #304555
*.color10: #30516C
*color10:  #30516C
*.color11: #56565B
*color11:  #56565B
*.color12: #976959
*color12:  #976959
*.color13: #B78D73
*color13:  #B78D73
*.color14: #47718B
*color14:  #47718B
*.color15: #c6c4c2
*color15:  #c6c4c2

! Black color that will not be affected by bold highlighting.
*.color66: #1e160d
*color66:  #1e160d

! Xclock colors.
XClock*foreground: #c6c4c2
XClock*background: #1e160d
XClock*majorColor:  rgba:c6/c4/c2/ff
XClock*minorColor:  rgba:c6/c4/c2/ff
XClock*hourColor:   rgba:c6/c4/c2/ff
XClock*minuteColor: rgba:c6/c4/c2/ff
XClock*secondColor: rgba:c6/c4/c2/ff

! Set depth to make transparency work.
URxvt*depth: 32
