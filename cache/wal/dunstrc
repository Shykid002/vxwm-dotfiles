[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 200
    origin = top-right
    offset = 10x50
    scale = 0
    notification_limit = 0

    # Updated to your new font!
    font = JetBrainsMono Nerd Font 10
    line_height = 0
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    stack_duplicates = true

    frame_width = 3
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    separator_color = frame

[urgency_low]
    background = "#0b0404"
    foreground = "#c2c0c0"
    frame_color = "#665454"
    timeout = 10

[urgency_normal]
    background = "#0b0404"
    foreground = "#c2c0c0"
    frame_color = "#575757"
    timeout = 10

[urgency_critical]
    background = "#0b0404"
    foreground = "#c2c0c0"
    frame_color = "#474747"
    timeout = 20
