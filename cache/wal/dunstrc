[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 200
    origin = top-right
    offset = 10x50
    scale = 0
    notification_limit = 0

    # Swapped Monospace for your newly installed JetBrainsMono Nerd Font!
    font = JetBrainsMono Nerd Font 10
    line_height = 0
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    stack_duplicates = true

    frame_width = 3
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    separator_color = frame

[urgency_low]
    background = "#12151b"
    foreground = "#c3c4c6"
    frame_color = "#5c6371"
    timeout = 10

[urgency_normal]
    background = "#12151b"
    foreground = "#c3c4c6"
    frame_color = "#545B4E"
    timeout = 10

[urgency_critical]
    background = "#12151b"
    foreground = "#c3c4c6"
    frame_color = "#545B4E"
    timeout = 10
