[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 200
    origin = top-right
    offset = 10x50
    scale = 0
    notification_limit = 0

    # Updated to your new font!
    font = JetBrainsMono Nerd Font 10
    line_height = 0
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    stack_duplicates = true

    frame_width = 3
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    separator_color = frame

[urgency_low]
    background = "#1e160d"
    foreground = "#c6c4c2"
    frame_color = "#70675c"
    timeout = 10

[urgency_normal]
    background = "#1e160d"
    foreground = "#c6c4c2"
    frame_color = "#30516C"
    timeout = 10

[urgency_critical]
    background = "#1e160d"
    foreground = "#c6c4c2"
    frame_color = "#304555"
    timeout = 20
