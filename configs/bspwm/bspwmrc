#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &

# Execute standalone environment and startup script
$HOME/.local/bin/bspwm-startup.sh &

# workspaces 
#bspc monitor -d 1 2 3 4 5 6
bspc monitor -d 一 二 三 四 五 六 七 八 九 十

# Start PipeWire audio servers
pipewire &
wireplumber &
pipewire-pulse ^

bspc config focus_follows_pointer true

# Notifications
dunst &


# Polkit
#/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
#/usr/lib/xfce4/xfce-polkit &
#/usr/bin/lxqt-policykit-agent

# Network Applet
#nm-applet --indicator &

# borders
bspc config border_width 2
bspc config borderless_monocle false


# 🌟 Active & Focused Windows (Changed to Catppuccin Pink)
bspc config focused_border_color "#f5c2e7"
bspc config active_border_color  "#f5c2e7"

# 💤 Inactive Windows & Feedback (Changed to match your Crust / Text theme)
bspc config normal_border_color  "#11111b"  
bspc config presel_feedback_color "#cdd6f4"



#gaps 
bspc config gapless_monocle false

bspc config window_gap 5
bspc config top_padding 30
bspc config bottom_padding 5
bspc config left_padding 3
bspc config right_padding 3

bspc config split_ratio 0.60

#moving floating windows and resize them with mouse, hold alt key
bspc config pointer_modifier mod4
bspc config pointer_action1 move
bspc config pointer_action2 resize_side
bspc config pointer_action3 resize_corner

#rules
bspc rule -a feh state=floating
bspc rule -a mpv state=floating
bspc rule -a openssh-askpass state=floating
bspc rule -a kdeconnect-app state=floating
bspc rule -a Pavucontrol state=floating
bspc rule -a vlc state=floating
bspc rule -a Pamac-manager state=floating
bspc rule -a Brave-browser desktop='^2' follow=on
bspc rule -a discord desktop='^6' follow=on
bspc rule -a spotify desktop='^5' follow=on
bspc rule -a TelegramDesktop desktop='^4' follow=on


# Set wallpaper:
#feh --bg-fill $HOME/Imágenes/fondos/stretched-1920-1080-1155716.png &

# Python script to always initialize with a different wallpaper:
~/.config/bspwm/scripts/launch.sh &

$HOME/.config/polybar/launch.sh &

sh ~/.config/polybar/wrm.sh &
# Picom
picom -b &
#picom

