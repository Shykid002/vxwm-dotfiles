# Use modernUX design disable OSC
osc=no
border=no



# --- Video Settings ---
# Use high-quality presets as a base
profile=gpu-hq
# Use GPU-accelerated decoding (auto-safe)
hwdec=auto-copy
# Use the newer video output for better features
vo=gpu-next

# --- Better Scaling (Sharper image) ---
# High-quality upscaling and downscaling
scale=spline36
dscale=mitchell
cscale=spline36

# --- Audio Settings ---
# Max volume (100 is default, 130 is 130%)
volume-max=130
# Set default volume to 70%
volume=70

# --- Subtitles ---
# Search for subtitles in folders like 'subs' or 'subtitles'
sub-auto=fuzzy
# Clearer subtitle font and size
sub-font="sans-serif"
sub-font-size=40

# --- Behavior & Interface ---
# Keep the player open after the file ends
idle=yes
# Save the playback position on exit
save-position-on-quit=yes
# Auto-hide the cursor after 1 second
cursor-autohide=1000
# High-quality screenshots (saves to desktop/mpv-screenshots)
screenshot-format=png
screenshot-high-bit-depth=yes
screenshot-directory="~/Desktop"

# --- Networking (for YouTube/URLs) ---
# Always use the best quality for online streams
ytdl-format=bestvideo+bestaudio/best


# Repeat 
loop-file=inf

# Repeat playlist
loop-playlist=inf

