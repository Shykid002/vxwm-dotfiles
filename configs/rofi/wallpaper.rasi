/* =========================================================================
   Rofi Wallpaper Picker Theme - Modern Dark Minimalist (Horizontal Strip)
   ========================================================================= */

* {
    bg-col:      #1e1e2e;
    bg-col-light:#313244;
    border-col:  #89b4fa;
    selected-col:#89b4fa;
    text-col:    #cdd6f4;
    text-sel:    #11111b;
    
    background-color: transparent;
    margin:     0;
    padding:    0;
}

window {
    /* Make the window wide across the screen and short like a dock */
    width:            85%;
    height:           270px;
    border:           2px;
    border-color:     @border-col;
    border-radius:    12px;
    background-color: @bg-col;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: @bg-col;
    children:         [ inputbar, listview ];
}

/* ==================== KOLOM PENCARIAN ==================== */
inputbar {
    children:   [ prompt, entry ];
    background-color: @bg-col;
    padding:    15px 15px 5px 15px;
}

prompt {
    background-color: @bg-col-light;
    padding:    10px;
    text-color: @border-col;
    border-radius: 6px 0px 0px 6px;
}

entry {
    background-color: @bg-col-light;
    padding:    10px;
    text-color: @text-col;
    border-radius: 0px 6px 6px 0px;
    placeholder: "Cari wallpaper...";
    placeholder-color: #6c7086;
}

/* ==================== DAFTAR WALLPAPER (HORIZONTAL) ==================== */
listview {
    border:       0px;
    padding:      10px 15px 15px 15px;
    margin:       0px;
    columns:      1;           /* MUST be 1 when layout is horizontal */
    lines:        100;         /* Large line pool to let it append cards infinitely sideways */
    spacing:      15px;
    cycle:        false;       /* Turn off loop-jump to keep scroll navigation linear */
    dynamic:      true;
    layout:       horizontal;  /* Force horizontal track layout */
}

element {
    padding:          10px;
    border-radius:    8px;
    background-color: transparent;
    text-color:       @text-col;
    orientation:      vertical; /* Image on top, label on the bottom */
    width:            160px;    /* Lock horizontal card thickness */
    children:         [ element-icon, element-text ];
}

/* Ukuran Kotak Preview Wallpaper */
element-icon {
    size:             130px; /* Uniform bounding space for thumbnail imagery */
    cursor:           pointer;
    border-radius:    6px;
    horizontal-align: 0.5;
}

element-text {
    vertical-align:   0.5;
    horizontal-align: 0.5;
    margin:           8px 0px 0px 0px; /* Put spacing above text, not left */
    text-color:       inherit;
    font:             "monospace 9";
}

/* Ketika Item Dipilih (Hover/Panah) */
element selected {
    background-color: @selected-col;
    text-color:       @text-sel;
}

